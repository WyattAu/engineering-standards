{
  "$description": "Estate seed palette, light variant. The 12 roles are theme-kit's closed vocabulary (REQ-THM-002); component and state tokens are derived, never authored (DESIGN.md DS-1, DS-7, DS-13).",
  "$extensions": {
    "estate": {
      "contrast": [
        {
          "bg": "{color.surface}",
          "fg": "{color.on-surface}",
          "name": "body"
        },
        {
          "bg": "{color.surface-raised}",
          "fg": "{color.on-surface}",
          "name": "body-raised"
        },
        {
          "bg": "{color.surface}",
          "fg": "{color.on-surface-muted}",
          "name": "muted"
        },
        {
          "bg": "{color.accent}",
          "fg": "{color.on-accent}",
          "name": "accent-label"
        },
        {
          "bg": "{color.surface}",
          "fg": "{color.warn}",
          "name": "warn"
        },
        {
          "bg": "{color.surface}",
          "fg": "{color.error}",
          "name": "error"
        },
        {
          "bg": "{color.surface}",
          "fg": "{color.success}",
          "name": "success"
        },
        {
          "bg": "{color.selection}",
          "fg": "{color.on-surface}",
          "name": "selection-body"
        },
        {
          "bg": "{color.surface}",
          "fg": "{color.border}",
          "kind": "ui",
          "name": "edge"
        },
        {
          "bg": "{color.surface}",
          "fg": "{color.focus-ring}",
          "kind": "ui",
          "name": "focus"
        }
      ]
    }
  },
  "$type": "color",
  "color": {
    "accent": {
      "$value": "#0969da"
    },
    "border": {
      "$value": "#6e7781"
    },
    "error": {
      "$value": "#cf222e"
    },
    "focus-ring": {
      "$value": "#0969da"
    },
    "on-accent": {
      "$value": "#ffffff"
    },
    "on-surface": {
      "$value": "#1f2328"
    },
    "on-surface-muted": {
      "$value": "#59636e"
    },
    "selection": {
      "$value": "#b6d7ff"
    },
    "success": {
      "$value": "#1a7f37"
    },
    "surface": {
      "$value": "#ffffff"
    },
    "surface-raised": {
      "$value": "#f6f8fa"
    },
    "warn": {
      "$value": "#9a6700"
    }
  }
}
