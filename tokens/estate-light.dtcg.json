{
  "$description": "Estate seed palette, light variant. The 12 roles are theme-kit's closed vocabulary (REQ-THM-002); component and state tokens are derived, never authored (DESIGN.md DS-1, DS-7, DS-13).",
  "$extensions": {
    "estate": {
      "contrast": [
        {
          "bg": "{color.surface}",
          "fg": "{color.on-surface}",
          "name": "body"
        },
        {
          "bg": "{color.surface-raised}",
          "fg": "{color.on-surface}",
          "name": "body-raised"
        },
        {
          "bg": "{color.surface}",
          "fg": "{color.on-surface-muted}",
          "name": "muted"
        },
        {
          "bg": "{color.accent}",
          "fg": "{color.on-accent}",
          "name": "accent-label"
        },
        {
          "bg": "{color.surface}",
          "fg": "{color.warn}",
          "name": "warn"
        },
        {
          "bg": "{color.surface}",
          "fg": "{color.error}",
          "name": "error"
        },
        {
          "bg": "{color.surface}",
          "fg": "{color.success}",
          "name": "success"
        },
        {
          "bg": "{color.selection}",
          "fg": "{color.on-surface}",
          "name": "selection-body"
        },
        {
          "bg": "{color.surface}",
          "fg": "{color.border}",
          "kind": "ui",
          "name": "edge"
        },
        {
          "bg": "{color.surface}",
          "fg": "{color.focus-ring}",
          "kind": "ui",
          "name": "focus"
        }
      ]
    }
  },
  "$type": "color",
  "color": {
    "accent": {
      "$value": "#0969da"
    },
    "border": {
      "$value": "#6e7781"
    },
    "error": {
      "$value": "#cf222e"
    },
    "focus-ring": {
      "$value": "#0969da"
    },
    "on-accent": {
      "$value": "#ffffff"
    },
    "on-surface": {
      "$value": "#1f2328"
    },
    "on-surface-muted": {
      "$value": "#59636e"
    },
    "selection": {
      "$value": "#b6d7ff"
    },
    "success": {
      "$value": "#1a7f37"
    },
    "surface": {
      "$value": "#ffffff"
    },
    "surface-raised": {
      "$value": "#f6f8fa"
    },
    "warn": {
      "$value": "#9a6700"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "base": {
        "$value": {
          "unit": "ms",
          "value": 240
        }
      },
      "fast": {
        "$value": {
          "unit": "ms",
          "value": 150
        }
      },
      "instant": {
        "$value": {
          "unit": "ms",
          "value": 100
        }
      },
      "reduced": {
        "$extensions": {
          "estate": {
            "note": "prefers-reduced-motion: reduce"
          }
        },
        "$value": {
          "unit": "ms",
          "value": 0
        }
      },
      "slow": {
        "$value": {
          "unit": "ms",
          "value": 320
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "enter": {
        "$value": [
          0.0,
          0.0,
          0.0,
          1.0
        ]
      },
      "exit": {
        "$value": [
          0.4,
          0.0,
          1.0,
          1.0
        ]
      },
      "standard": {
        "$value": [
          0.2,
          0.0,
          0.0,
          1.0
        ]
      }
    }
  },
  "space": {
    "$extensions": {
      "estate": {
        "base": 4,
        "rhythm": 8
      }
    },
    "$type": "dimension",
    "lg": {
      "$value": {
        "unit": "px",
        "value": 16
      }
    },
    "md": {
      "$value": {
        "unit": "px",
        "value": 12
      }
    },
    "sm": {
      "$value": {
        "unit": "px",
        "value": 8
      }
    },
    "xl": {
      "$value": {
        "unit": "px",
        "value": 24
      }
    },
    "xs": {
      "$value": {
        "unit": "px",
        "value": 4
      }
    },
    "xxl": {
      "$value": {
        "unit": "px",
        "value": 32
      }
    },
    "xxxl": {
      "$value": {
        "unit": "px",
        "value": 48
      }
    },
    "xxxxl": {
      "$value": {
        "unit": "px",
        "value": 64
      }
    }
  },
  "type": {
    "$extensions": {
      "estate": {
        "base": 16,
        "ratio": 1.25,
        "ratioTolerance": 0.05
      }
    },
    "$type": "dimension",
    "size": {
      "body": {
        "$extensions": {
          "estate": {
            "lineHeight": 1.5
          }
        },
        "$value": {
          "unit": "px",
          "value": 16
        }
      },
      "caption": {
        "$extensions": {
          "estate": {
            "lineHeight": 1.55
          }
        },
        "$value": {
          "unit": "px",
          "value": 13
        }
      },
      "display": {
        "$extensions": {
          "estate": {
            "lineHeight": 1.2
          }
        },
        "$value": {
          "unit": "px",
          "value": 31
        }
      },
      "heading": {
        "$extensions": {
          "estate": {
            "lineHeight": 1.25
          }
        },
        "$value": {
          "unit": "px",
          "value": 25
        }
      },
      "title": {
        "$extensions": {
          "estate": {
            "lineHeight": 1.4
          }
        },
        "$value": {
          "unit": "px",
          "value": 20
        }
      }
    }
  }
}
